# Application
APP_NAME="Casa-blog Immo"
APP_REGION=Casamance
APP_DEFAULT_CITY=Ziguinchor
APP_COUNTRY=Sénégal
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/zig-imobilier
APP_TIMEZONE=Africa/Dakar
APP_LOCALE=fr

# Traduction (contenu dynamique)
TRANSLATION_DRIVER=libretranslate
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT=8
MYMEMORY_EMAIL=

# Base de données : voir config/database.php ($db_host, $db_name, $db_user, $db_pass)

# Session
SESSION_LIFETIME=7200
SESSION_NAME=zig_imobilier_session

# Sécurité
CSRF_TOKEN_NAME=_token

# Mail SMTP (cPanel — SSL/TLS)
MAIL_MAILER=smtp
MAIL_HOST=premium35.web-hosting.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-replaye@casa-blog-immo.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-replaye@casa-blog-immo.com
MAIL_FROM_NAME="Casa-blog Immo"
MAIL_VERIFY_PEER=true
# Logo dans le corps des e-mails (chemin relatif au projet)
MAIL_INLINE_BRAND_IMAGE=assets/images/brand/icon-casa-immo.png
# Avatar à gauche du nom dans Gmail (BIMI) : après SPF + DKIM + DMARC valides, ajouter chez Namecheap :
# TXT default._bimi → v=BIMI1; l=https://casa-blog-immo.com/assets/images/brand/icon-192.png;
# (Gmail affiche souvent le logo BIMI seulement avec certificat VMC ; sinon corriger l’authentification évite le « ? » rouge.)

# Automatisation (aucune commande manuelle requise) :
# - migrations SQL à chaque visite du site
# - e-mail de confirmation à chaque réservation (+ relance auto si SMTP en échec, toutes les 5 min)
# - séjours terminés + rappel avis J+2 (1×/jour au trafic du site)
# Optionnel serveur : CRON_SECRET + GET /cron/run?token=... ou `php cron.php`
CRON_SECRET=

# Paiement (étape ultérieure)
PAYMENT_API_KEY=
